      {
        "type": "color",
        "id": "surface_hover_color",
        "label": "Surface Hover",
        "default": "#F3F3F3"
      },
      {
        "type": "color",
        "id": "border_color",
        "label": "Border Color",
        "default": "rgba(0,0,0,0.05)"
