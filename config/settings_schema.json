[
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "Primary font (Body & UI)"
      },
      {
        "type": "font_picker",
        "id": "type_secondary_font",
        "default": "work_sans_n6",
        "label": "Secondary font (Headings & Accent)"
      },
      {
        "type": "range",
        "id": "heading_base_size",
        "min": 16,
        "max": 48,
        "step": 2,
        "unit": "px",
        "label": "Base heading size",
        "default": 28
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 1,
        "max": 2,
        "step": 0.1,
        "label": "Heading scale",
        "default": 1.2
      }
    ]
  },
  {
    "name": "Border Radius",
    "settings": [
      {
        "type": "range",
        "id": "radius_base",
        "label": "Base radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "default": 12
      }
    ]
  },
  {
    "name": "Spacing",
    "settings": [
      {
        "type": "header",
        "content": "Spacing Scale"
      },
      {
        "type": "range",
        "id": "spacing_base",
        "label": "Base spacing",
        "min": 4,
        "max": 32,
        "step": 2,
        "unit": "px",
        "default": 8
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "header",
        "content": "Page Layout"
      },
      {
        "type": "select",
        "id": "max_page_width",
        "label": "Maximum page width",
        "options": [
          {
            "value": "90rem",
            "label": "Narrow"
          },
          {
            "value": "110rem",
            "label": "Wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Minimum page margin",
        "default": 20
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "Global Site Background"
      },
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "Fallback Background Color",
        "info": "Used as base background and during image loading."
      },
      {
        "type": "image_picker",
        "id": "site_background_image",
        "label": "Background Image / SVG Pattern"
      },
      {
        "type": "select",
        "id": "site_background_size",
        "label": "Image Size & Scale",
        "options": [
          { "value": "cover", "label": "Fill Screen (Cover)" },
          { "value": "contain", "label": "Fit Screen (Contain)" },
          { "value": "auto", "label": "Original / Tile (Repeat)" }
