      {
        "type": "color",
        "id": "text_secondary_color",
        "label": "Secondary Text",
        "default": "#444444"
      },
      {
        "type": "color",
        "id": "text_muted_color",
        "label": "Muted Text",
        "default": "#777777"
      },
      {
        "type": "color",
        "id": "success_color",
        "label": "Success Status",
        "default": "#4CAF50"
      },
      {
        "type": "color",
        "id": "danger_color",
        "label": "Danger / Error Status",
        "default": "#FF4D4F"
      },
      {
        "type": "color",
        "id": "rating_color",
        "label": "Rating / Stars",
        "default": "#FFB800"
      }
