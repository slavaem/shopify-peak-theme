        "default": "1/1"
      },
      {
        "type": "select",
        "id": "image_fit",
        "label": "Image fit",
        "options": [
          { "value": "cover", "label": "Fill (Cover)" },
          { "value": "contain", "label": "Show all (Contain)" }
        ],
        "default": "cover"
      },
      {
        "type": "range",
        "id": "card_title_size",
        "min": 12,
        "max": 24,
        "step": 1,
        "unit": "px",
        "label": "Product title size",
        "default": 16
