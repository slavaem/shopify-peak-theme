{%- assign sid = section.id -%}

{%- liquid
  assign is_design_mode = request.design_mode

  assign bg_value = 'var(--color-background)'
  assign text_value = 'var(--color-foreground)'

  if section.settings.color_mode == 'custom'
    assign bg_value = section.settings.bg_color
    assign text_value = section.settings.text_color
  endif

  assign logo_font = section.settings.logo_font
-%}

{%- if logo_font != blank -%}
  {%- style -%}
    {{ logo_font | font_face: font_display: 'swap' }}
  {%- endstyle -%}
{%- endif -%}

<header 
  id="shopify-section-{{ sid }}-header"
  class="site-header site-header--{{ section.settings.header_layout }} {% if section.settings.sticky_header %}is-sticky{% endif %} {% if section.settings.bg_image != blank %}has-bg-image{% endif %}"
  data-component="header"
>

  <button 
    type="button" 
    class="header__burger-btn" 
    aria-label="Open menu"
    aria-expanded="false"
    data-action="mobile-menu-toggle"
  >
    <span></span>
    <span></span>
    <span></span>
  </button>

  {% render 'mobile-menu', menu: section.settings.menu %}

  <div class="header__title">
    <a href="{{ routes.root_url }}" class="header__logo-link">
      {% if section.settings.logo != blank %}
        {% render 'image',
          image: section.settings.logo,
          width: section.settings.logo_width,
          class: 'header__logo',
          widths: '100,120,140,160,180,200,240,300,360,480',
          sizes: '(max-width: 768px) min(140px, {{ section.settings.logo_width }}px), {{ section.settings.logo_width }}px',
          loading: 'eager',
          alt: shop.name
        %}
      {% endif %}

      {% if section.settings.logo_text != blank %}
        <span class="header__logo-text header__logo-text--custom">
          {{ section.settings.logo_text | escape }}
        </span>
      {% elsif section.settings.logo == blank %}
        <span class="header__logo-text header__logo-text--default">
          PEAK<span class="logo-accent">.</span>
        </span>
      {% endif %}
    </a>
  </div>

  <nav class="header__menu" aria-label="Main navigation" data-menu-container>
    {% if section.settings.menu != blank and section.settings.menu.links.size > 0 %}
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}" class="header__link" data-menu-item>
          {{ link.title }}
        </a>
      {% endfor %}
    {% elsif is_design_mode %}
      <a href="#" class="header__link" data-menu-item>Home</a>
      <a href="#" class="header__link" data-menu-item>Catalog</a>
      <a href="#" class="header__link" data-menu-item>About Us</a>
      <a href="#" class="header__link" data-menu-item>Contact</a>
    {% endif %}

    <details class="menu-more" data-menu-more>
      <summary class="header__link">{{ 'sections.header.menu_more' | t | default: 'More' }}</summary>
      <div class="menu-more__dropdown" data-menu-dropdown></div>
    </details>
  </nav>

  <div class="header__right">
    <div class="header__localization">
      {%- form 'localization', id: 'HeaderLocalizationForm' -%}
        <div class="localization-group">

          <!-- LANGUAGE -->
          {%- if localization.available_languages.size > 1 -%}
            <localization-form data-type="locale">
              <div class="localization-item">
                <button type="button" class="localization-btn" aria-expanded="false">
                  {{ localization.language.iso_code | upcase }}
                </button>

                <ul class="localization-dropdown" hidden>
                  {%- for language in localization.available_languages -%}
                    <li>
                      <a href="#" data-value="{{ language.iso_code }}">
                        {{ language.iso_code | upcase }}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>

                <input type="hidden" name="locale_code" value="{{ localization.language.iso_code }}">
              </div>
            </localization-form>
          {%- endif -%}

          <!-- CURRENCY -->
          {% if localization.available_countries.size > 1 %}
            <localization-form data-type="currency">
              <div class="localization-item">
                <button type="button" class="localization-btn" aria-expanded="false" data-state="closed">
                  {{ localization.country.currency.iso_code }}
                </button>

                {% assign shown_currencies = '' %}

                <ul class="localization-dropdown" hidden>
                  {%- for country in localization.available_countries -%}
                    {% unless shown_currencies contains country.currency.iso_code %}
                      <li>
                        <a href="#" data-value="{{ country.iso_code }}">
                          {{ country.currency.iso_code }}
                        </a>
                      </li>
                      {% assign shown_currencies = shown_currencies | append: country.currency.iso_code | append: ',' %}
                    {% endunless %}
                  {%- endfor -%}
                </ul>

                <input type="hidden" name="country_code" value="{{ localization.country.iso_code }}">
              </div>
            </localization-form>
          {%- endif -%}

        </div>
      {%- endform -%}
    </div>

    <div class="header__icons">

      {% if section.settings.show_account and shop.customer_accounts_enabled %}
        <a href="{{ routes.account_url }}" aria-label="Account">
          {% if section.settings.icon_account %}
            {% render 'image', image: section.settings.icon_account, width: 40, loading: 'lazy' %}
          {% else %}
            {{ 'icon-account.svg' | inline_asset_content }}
          {% endif %}
        </a>
      {% endif %}

      <header-wishlist class="header__wishlist">
        {% if section.settings.show_wishlist %}
          <a href="/pages/wishlist" aria-label="Go to wishlist" data-action="wishlist-open">
            <span class="icon-wrapper">
              {% if section.settings.icon_wishlist %}
                {% render 'image', image: section.settings.icon_wishlist, width: 40, loading: 'lazy' %}
              {% else %}
                {{ 'icon-wishlist.svg' | inline_asset_content | default: '♥'}}
              {% endif %}
            </span>

            <span data-wishlist-count class="cart-count-badge hidden">0</span>
          </a>
        {% endif %}
      </header-wishlist>

      <header-cart class="header__cart-link">
        <a href="{{ routes.cart_url }}" aria-label="Cart" data-action="cart-open">
          <span
            data-cart-count
            class="cart-count-badge {% if cart.item_count == 0 %}hidden{% endif %}"
          >
            {{ cart.item_count }}
          </span>

          {% if section.settings.icon_cart %}
            {% render 'image', image: section.settings.icon_cart, width: 40, loading: 'lazy' %}
          {% else %}
            {{ 'icon-cart.svg' | inline_asset_content }}
          {% endif %}
        </a>
      </header-cart>

    </div>
  </div>
</header>

{% style %}
#shopify-section-{{ section.id }} {
  --logo-width: {{ section.settings.logo_width | default: 180 }}px;
  --header-icon-size: {{ section.settings.icon_size | default: 24 }}px;
  --logo-text-font-size: {{ section.settings.logo_text_size | default: 22 }}px;
  --logo-text-weight: {{ logo_font.weight | default: section.settings.logo_text_weight | default: '800' }};
  --logo-text-style: {{ logo_font.style | default: 'normal' }};
  --logo-text-transform: {{ section.settings.logo_text_transform | default: 'uppercase' }};
  --logo-text-spacing: {{ section.settings.logo_text_spacing | default: 1 }}px;
  
  --header-bg: {{ bg_value }};
  --header-text: {{ text_value }};
}

.site-header {
  min-height: 70px;
  width: 100%;
  display: grid;
  grid-template-columns: auto max-content minmax(0, 1fr) auto;
  grid-template-areas: "burger-zone logo-zone menu-zone right-zone";
  align-items: center;
  padding: calc(var(--space-sm) / 2) var(--page-padding, 5%);
  gap: var(--space-sm);
  background-color: var(--header-bg);
  color: var(--header-text);
  
  {% if section.settings.bg_image != blank %}
    background-image: url('{{ section.settings.bg_image | image_url: width: 2000 }}');
    background-size: {{ section.settings.bg_size | default: 'cover' }};
    background-position: {{ section.settings.bg_position | default: 'center center' }};
    background-repeat: no-repeat;
  {% endif %}

  border-bottom: 1px solid var(--color-border-light);
  position: relative;
  z-index: var(--z-header, 1000);
}

.site-header a,
.header__logo-text,
.header__link,
.localization-btn {
  color: var(--header-text);
}

.header__burger-btn {
  grid-area: burger-zone;
  justify-self: start;
  display: none;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: var(--space-2xs, 4px);
  width: var(--control-size-md, 36px);
  height: var(--control-size-md, 36px);
  padding: var(--space-2xs, 4px);
  background: transparent;
  border: none;
  cursor: pointer;
  color: var(--header-text);
  z-index: calc(var(--z-header, 100) + 1);
  transition: opacity var(--transition-fast, 0.2s ease);
}

.header__burger-btn:hover {
  opacity: 0.8;
}

.header__burger-btn span {
  display: block;
  width: var(--icon-size-lg, 24px);
  height: 2px;
  background-color: currentColor;
  transition: transform var(--transition-fast, 0.2s ease), opacity var(--transition-fast, 0.2s ease);
  border-radius: var(--radius-xs, 2px);
}

.header__title { grid-area: logo-zone; justify-self: start; display: flex; max-width: 100%; min-width: 0; }

.header__logo-link {
  display: inline-flex;
  align-items: center;
  gap: var(--space-xs, 8px);
  text-decoration: none;
}

#shopify-section-{{ section.id }} .header__title {
  max-width: var(--logo-width);
  width: 100%;
  flex-shrink: 0;
}

#shopify-section-{{ section.id }} .header__logo-link {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  width: 100%;
}

#shopify-section-{{ section.id }} .header__logo,
#shopify-section-{{ section.id }} .header__logo.image,
#shopify-section-{{ section.id }} .header__logo img,
#shopify-section-{{ section.id }} .header__logo .image__img {
  width: 100% !important;
  max-width: var(--logo-width) !important;
  height: auto !important;
  object-fit: contain;
  display: block;
}

.header__logo-text {
  {% if logo_font != blank %}
    font-family: {{ logo_font.family }}, {{ logo_font.fallback_families }};
    font-weight: var(--logo-text-weight);
    font-style: var(--logo-text-style);
  {% else %}
    font-family: var(--font-family-heading, var(--font-primary--family));
  {% endif %}
  display: inline-flex;
  align-items: center;
  line-height: 1;
}

.header__logo-text--default {
  font-size: var(--font-size-xl, 22px);
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.header__logo-text--default .logo-accent {
  color: var(--color-accent, #E41616);
  margin-left: -0.05em;
}

.header__logo-text--custom {
  font-size: var(--logo-text-font-size);
  font-weight: var(--logo-text-weight);
  letter-spacing: var(--logo-text-spacing);
  text-transform: var(--logo-text-transform);
}

.header__menu {
  grid-area: menu-zone;
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  overflow: visible; 
  white-space: nowrap; 
  flex: 1 1 auto;
  min-width: 0; 
}

.header__right { grid-area: right-zone; justify-self: end; display: flex; align-items: center; gap: var(--space-sm); flex-wrap: nowrap; }

.site-header a {
  position: relative;
  text-decoration: none;
}

.header__link {
  font-size: var(--text-body);
  font-weight: var(--font-weight-medium);
}

.header__link:hover {
  opacity: 0.7;
}

.header__icons a {
  padding: calc(var(--space-sm) / 3);
  display: flex;
  align-items: center;
}

.site-header--left-logo {
  grid-template-columns: auto minmax(120px, auto) minmax(0, 1fr) auto;
  grid-template-areas: "burger-zone logo-zone menu-zone right-zone";
}

.site-header--center-logo {
  grid-template-rows: auto auto;
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  grid-template-areas: 
    "burger-zone logo-zone right-zone"
    "menu-zone menu-zone menu-zone"; 
  row-gap: var(--space-sm); 
  padding-top: 1dvw;
}

.site-header--center-logo .header__title {
  grid-area: logo-zone;
  justify-self: center;
}

.site-header--center-logo .header__menu {
  grid-area: menu-zone;
  justify-content: center;
  width: 100%;
  padding: var(--space-sm) 0;
  border-top: 1px solid var(--color-border-light);
}

.site-header--right-menu {
  grid-template-columns: 1fr auto 1fr;
  grid-template-areas: "right-zone logo-zone menu-zone";
  gap: var(--space-md);
}

.site-header--right-menu .header__right {
  grid-area: right-zone;
  display: flex;
  align-items: center;
  justify-self: start;
  min-width: 0;
}

.site-header--right-menu .header__title {
  grid-area: logo-zone;
  justify-self: center;
}

.site-header--right-menu .header__menu {
  grid-area: menu-zone;
  display: flex;
  min-width: 0;
}

.site-header--right-menu .header__icons { order: 1; }
.site-header--right-menu .header__localization { order: 2; }

/* ================================
   MENU MORE
================================ */
.menu-more {
  overflow: visible;
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  position: relative;
}

.menu-more summary {
  list-style: none;
  cursor: pointer;
  display: flex;
  align-items: center;
}

.menu-more summary::-webkit-details-marker {
  display: none;
}

[data-menu-container] {
  display: flex;
  align-items: center;
  white-space: nowrap;
  min-width: 0;
  max-width: 100%;
  flex: 1 1 auto;
  margin-left: auto;
}

.menu-more__dropdown {
  position: absolute;
  top: calc(100% + 8px);
  right: 0;
  background: var(--header-bg);
  color: var(--header-text);
  display: none;
  flex-direction: column;
  z-index: 9999;
  min-width: calc(var(--space-md) * 6);
  padding: var(--space-sm) 0;
  border-radius: var(--radius-md);
  box-shadow: var(--card-shadow);
  gap: var(--space-sm);
  border: 1px solid var(--color-border-light);
}

.menu-more[open] .menu-more__dropdown {
  position: absolute;
  display: flex;
}

[data-menu-item] {
  flex: 0 0 auto !important;
}

.menu-more__dropdown [data-menu-item] {
  padding: var(--space-sm) var(--space-md);
  width: 100%;
}

.menu-more[data-state="hidden"] {
  display: none;
}

.menu-more__dropdown [data-menu-item]:hover {
  background: var(--color-surface-subtle);
}

.menu-more__dropdown .header__link {
  padding: var(--space-sm) var(--space-lg);
  width: 100%;
  display: block;
}

/* ================================
   ICONS
================================ */
.header__icons {
  display: flex;
  gap: var(--space-sm);
  min-width: max-content;
}

.header__icons svg,
.header__icons img,
.header__icons .image {
  width: var(--header-icon-size);
  height: var(--header-icon-size);
  display: block;
  object-fit: contain;
}

/* ================================
   CART LINK & BADGES
================================ */
.header__cart-link,
.header__wishlist {
  display: flex;
  align-items: center;
  position: relative;
}

.header__cart-link:hover .cart-count-badge,
.header__wishlist:hover .cart-count-badge {
  transform: scale(1.05);
}

.cart-count-badge {
  position: absolute;
  top: calc(var(--space-sm) * -0.5);
  right: calc(var(--space-sm) * -0.5);
  background: var(--color-danger, #e53e3e);
  color: #ffffff;
  font-size: var(--text-small, 12px);
  padding: 2px calc(var(--space-sm) / 2);
  border-radius: 999px;
  font-weight: 600;
  min-width: 18px;
  text-align: center;
  line-height: 1;
}

.cart-count-badge.hidden {
  display: none;
}

/* ================================
   LANGUAGE and MONEY
================================ */
.localization-group {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}

.localization-item {
  position: relative;
}

.localization-btn {
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid var(--color-border-light);
  border-radius: 999px;
  font-size: var(--text-small);
  font-weight: 600;
  cursor: pointer;
  transition: var(--card-transition);
  padding: calc(var(--space-sm) / 2) var(--space-sm);
}

.localization-btn:hover {
  background: rgba(255, 255, 255, 0.2);
}

.localization-dropdown {
  position: absolute;
  top: calc(100% + var(--space-xs, 6px));
  left: 0;
  background: var(--header-bg);
  color: var(--header-text);
  border-radius: var(--radius-md);
  padding: calc(var(--space-sm) / 2) 0;
  min-width: calc(var(--space-md) * 3);
  box-shadow: var(--card-shadow);
  list-style: none;
  z-index: 100;
  border: 1px solid var(--color-border-light);
}

.localization-dropdown li a {
  display: block;
  padding: calc(var(--space-sm) / 1.5) var(--space-md);
  font-size: var(--text-small);
  text-align: center;
  color: var(--header-text);
  transition: var(--card-transition);
}

.localization-dropdown li a:hover {
  background: var(--color-surface-subtle);
}

.site-header.is-sticky {
  position: fixed;
  top: 0;
}

/* ================================
   MOBILE MENU DRAWER
================================ */
.mobile-menu {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  height: 100dvh;
  z-index: calc(var(--z-header, 100) + 100);
  display: flex;
  visibility: hidden;
  pointer-events: none;
  transition: visibility var(--transition-base, 0.3s ease);
}

.mobile-menu[hidden] {
  display: flex !important;
  visibility: hidden;
  pointer-events: none;
}

.mobile-menu[data-state="open"] {
  visibility: visible;
  pointer-events: auto;
}

.mobile-menu__overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: var(--color-overlay, rgba(0, 0, 0, 0.5));
  backdrop-filter: blur(4px);
  opacity: 0;
  transition: opacity var(--transition-base, 0.3s ease);
}

.mobile-menu[data-state="open"] .mobile-menu__overlay {
  opacity: 1;
}

.mobile-menu__panel {
  position: relative;
  width: min(85vw, 360px);
  height: 100%;
  background-color: var(--color-background, #ffffff);
  color: var(--color-foreground, #121212);
  display: flex;
  flex-direction: column;
  transform: translateX(-100%);
  transition: transform var(--card-transition, 0.3s cubic-bezier(0.16, 1, 0.3, 1));
  box-shadow: var(--shadow-lg);
  z-index: 1;
}

.mobile-menu[data-state="open"] .mobile-menu__panel {
  transform: translateX(0);
}

.mobile-menu__header {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: var(--space-md) var(--space-lg);
  border-bottom: 1px solid var(--color-border-light, rgba(0, 0, 0, 0.08));
}

.mobile-menu__close {
  background: transparent;
  border: none;
  font-size: var(--font-size-2xl, 28px);
  line-height: 1;
  width: var(--control-size-sm, 32px);
  height: var(--control-size-sm, 32px);
  border-radius: 50%;
  cursor: pointer;
  color: inherit;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color var(--transition-fast, 0.2s ease);
}

.mobile-menu__close:hover {
  background-color: var(--color-surface-subtle, rgba(0, 0, 0, 0.05));
}

.mobile-menu__nav {
  flex: 1 1 auto;
  overflow-y: auto;
  padding: var(--space-sm) 0;
}

.mobile-menu__list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
}

.mobile-menu__link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-sm) var(--space-lg);
  font-size: var(--font-size-md, 18px);
  font-weight: var(--font-weight-medium, 500);
  color: inherit;
  text-decoration: none;
  transition: background-color var(--transition-fast, 0.2s ease), color var(--transition-fast, 0.2s ease);
}

.mobile-menu__link:hover,
.mobile-menu__link.is-active {
  background-color: var(--color-surface-subtle, rgba(0, 0, 0, 0.04));
  font-weight: var(--font-weight-bold, 700);
}

@media (max-width: 768px) {
  .site-header {
    grid-template-rows: auto !important;
    grid-template-columns: auto 1fr auto !important;
    grid-template-areas: "burger-zone logo-zone right-zone" !important;
    gap: var(--space-xs) var(--space-sm) !important;
  }

  .site-header--center-logo {
    grid-template-rows: auto auto !important;
    grid-template-columns: auto 1fr auto !important;
    grid-template-areas: 
      "logo-zone logo-zone logo-zone"
      "burger-zone . right-zone" !important;
    row-gap: var(--space-xs, 8px) !important;
    padding-top: var(--space-sm) !important;
    padding-bottom: var(--space-xs) !important;
  }

  .site-header--center-logo .header__title {
    grid-area: logo-zone !important;
    justify-self: center !important;
    margin-bottom: var(--space-2xs, 4px);
  }

  .site-header--center-logo .header__burger-btn {
    grid-area: burger-zone !important;
    justify-self: start !important;
  }

  .site-header--center-logo .header__right {
    grid-area: right-zone !important;
    justify-self: end !important;
  }

  .site-header--center-logo #shopify-section-{{ section.id }} .header__logo,
  .site-header--center-logo #shopify-section-{{ section.id }} .header__logo img {
    max-width: min(var(--logo-width), 160px) !important;
  }

  .site-header--right-menu {
    grid-template-columns: auto 1fr auto !important;
    grid-template-areas: "logo-zone right-zone burger-zone" !important;
  }

  .site-header--right-menu .header__title {
    justify-self: start !important;
  }

  .header__burger-btn {
    display: flex !important;
  }

  .header__menu {
    display: none !important;
  }

  #shopify-section-{{ section.id }} .header__logo,
  #shopify-section-{{ section.id }} .header__logo.image,
  #shopify-section-{{ section.id }} .header__logo img {
    max-width: min(var(--logo-width), 140px) !important;
  }
}
{% endstyle %}

<script>
class LocalizationForm extends HTMLElement {
  constructor() {
    super();
    this.button = this.querySelector('button');
    this.panel = this.querySelector('ul');
    this.form = this.closest('form');
    this.type = this.dataset.type; 

    if (!this.button || !this.panel) return;

    this.button.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      this.toggle();
    });

    document.addEventListener("click", (e) => {
      if (!this.contains(e.target)) this.hide();
    });
    
    this.panel.querySelectorAll("a").forEach(item => {
      item.addEventListener("click", (e) => {
        e.preventDefault();
        const value = e.currentTarget.dataset.value;
        const inputName = this.type === 'locale' ? 'locale_code' : 'country_code';
        this.form.querySelector(`input[name="${inputName}"]`).value = value;
        this.form.submit();
      });
    });
  }

  toggle() {
    const isExpanded = this.button.getAttribute("aria-expanded") === "true";
    
    this.form.querySelectorAll('localization-form').forEach(form => {
      if (form !== this) form.hide();
    });

    const nextState = !isExpanded;
    this.button.setAttribute("aria-expanded", nextState);
    this.button.dataset.state = nextState ? "open" : "closed";
    
    if (nextState) {
      this.panel.removeAttribute("hidden");
    } else {
      this.panel.setAttribute("hidden", "");
    }
  }

  hide() {
    this.button.setAttribute("aria-expanded", "false");
    this.button.dataset.state = "closed";
    this.panel.setAttribute("hidden", "");
  }
}
customElements.define("localization-form", LocalizationForm);

class HeaderCart extends HTMLElement {
  connectedCallback() {
    this.badge = this.querySelector("[data-cart-count]");
    if (!this.badge) return;

    const init = () => {
      if (window.CartStore) {
        this.update(window.CartStore.get());
        window.CartStore.subscribe((cart) => this.update(cart));
      }
    };

    if (window.CartStore) init();
    else document.addEventListener("cart:ready", init); 
  }

  update(cart) {
    if (!cart) return;
    const count = cart.item_count;
    this.badge.textContent = count;
    this.badge.classList.toggle("hidden", count === 0);
    
    if (count > 0) {
      this.badge.dataset.state = "updated";
      setTimeout(() => {
        delete this.badge.dataset.state;
      }, 300);
    }
  }
}
customElements.define("header-cart", HeaderCart);

class HeaderWishlist extends HTMLElement {
  connectedCallback() {
    this.badge = this.querySelector("[data-wishlist-count]");
    if (!this.badge) return;

    const init = () => {
      if (window.WishlistStore) {
        this.update(window.WishlistStore.get());
        window.WishlistStore.subscribe((items) => this.update(items));
      }
    };

    if (window.WishlistStore) init();
    else document.addEventListener("wishlist:updated", init);
  }

  update(items) {
    const count = items.length;
    this.badge.textContent = count;
    this.badge.classList.toggle("hidden", count === 0);
  }
}
customElements.define("header-wishlist", HeaderWishlist);

document.addEventListener('DOMContentLoaded', () => {
  const container = document.querySelector('[data-menu-container]');
  if (!container) return;

  const moreBtn = container.querySelector('[data-menu-more]');
  const dropdown = container.querySelector('[data-menu-dropdown]');
  
  const allItems = Array.from(container.querySelectorAll('[data-menu-item]'));

  const updateMenu = () => {
    if (moreBtn.open) moreBtn.open = false;

    allItems.forEach(item => {
      container.insertBefore(item, moreBtn);
    });

    moreBtn.dataset.state = "hidden";

    let i = allItems.length - 1;
    while (container.scrollWidth > container.clientWidth && i >= 0) {
      dropdown.prepend(allItems[i]);
      moreBtn.dataset.state = "visible"; 
      i--;
    }

    container.dataset.overflow = (dropdown.children.length > 0).toString();
  };

  const observer = new ResizeObserver(() => {
    window.requestAnimationFrame(updateMenu);
  });

  observer.observe(container);
  updateMenu();
});
</script>

