{%- assign sid = section.id -%}

{%- liquid
  assign hosted_video = section.settings.hosted_video
  assign remote_video = section.settings.video_url

  assign heading_text = section.settings.heading
  if heading_text == blank
    assign heading_text = 'sections.video_hero.heading' | t
  endif

  assign subtitle_text = section.settings.subtitle
  if subtitle_text == blank
    assign subtitle_text = 'sections.video_hero.subtitle' | t
  endif

  assign button_text = section.settings.button_label
  if button_text == blank
    assign button_text = 'sections.video_hero.button_label' | t
  endif

  assign button_link = section.settings.button_link | default: routes.all_products_collection_url
  
  assign iframe_title = heading_text | default: 'Background Video' | escape
-%}

<section 
  id="video-hero-{{ sid }}" 
  class="video-hero-wrapper section"
  data-component="video-hero"
>
  <div class="video-hero-container">
    
    {%- if hosted_video != blank -%}
      {%- liquid
        assign poster_image = hosted_video.preview_image
        assign poster_url = poster_image | image_url: width: 1200
      -%}

      {{ hosted_video | video_tag: 
        autoplay: true, 
        loop: true, 
        muted: true, 
        controls: false, 
        playsinline: true, 
        preload: 'metadata',
        poster: poster_url,
        class: 'video-bg js-video' 
      }}
    {%- elsif remote_video != blank -%}
      <div class="video-bg iframe-wrapper">
        {%- if remote_video.type == 'youtube' -%}
          <iframe 
            src="https://www.youtube.com/embed/{{ remote_video.id }}?autoplay=1&loop=1&playlist={{ remote_video.id }}&mute=1&controls=0&rel=0&showinfo=0&modestbranding=1&enablejsapi=1&playsinline=1" 
            frameborder="0" 
            allow="autoplay; encrypted-media" 
            title="{{ iframe_title }}"
            allowfullscreen
          ></iframe>
        {%- elsif remote_video.type == 'vimeo' -%}
          <iframe 
            src="https://player.vimeo.com/video/{{ remote_video.id }}?autoplay=1&loop=1&muted=1&background=1" 
            frameborder="0" 
            allow="autoplay; fullscreen" 
            title="{{ iframe_title }}"
            allowfullscreen
          ></iframe>
        {%- endif -%}
      </div>
    {%- else -%}
      <div class="video-bg video-placeholder">
        {%- if request.design_mode -%}
          <div class="video-placeholder__badge">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"></rect><line x1="7" y1="2" x2="7" y2="22"></line><line x1="17" y1="2" x2="17" y2="22"></line><line x1="2" y1="12" x2="22" y2="12"></line><line x1="2" y1="7" x2="7" y2="7"></line><line x1="2" y1="17" x2="7" y2="17"></line><line x1="17" y1="17" x2="22" y2="17"></line><line x1="17" y1="7" x2="22" y2="7"></line></svg>
            <span>Please add a video in section settings</span>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="overlay"></div>

    <div class="hero-content">
      {%- if heading_text != blank -%}
        <h1 class="hero-title">
          {{ heading_text | escape }}
        </h1>
      {%- endif -%}
      
      {%- if subtitle_text != blank -%}
        <p class="hero-subtitle">
          {{ subtitle_text | escape }}
        </p>
      {%- endif -%}

      {%- if button_text != blank -%}
        <a href="{{ button_link }}" class="btn btn--primary hero-btn">
          {{ button_text | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% style %}
#video-hero-{{ sid }} {
  --color-hero-text: {{ section.settings.text_color | default: '#ffffff' }};
  width: 100%;
}

#video-hero-{{ sid }} .video-hero-container {
  container-type: inline-size;
  container-name: hero_container;
  position: relative;
  width: 100%;
  height: {{ section.settings.height_desktop }}vh;
  min-height: 400px; 
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

#video-hero-{{ sid }} .video-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center center;
  z-index: 0;
}

#video-hero-{{ sid }} .iframe-wrapper {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 100%;
  height: 100%;
  transform: translate(-50%, -50%);
  overflow: hidden;
  pointer-events: none;
}

#video-hero-{{ sid }} .iframe-wrapper iframe {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 100vw;
  height: 56.25vw;
  min-height: 100vh;
  min-width: 177.77vh;
  transform: translate(-50%, -50%) scale(1.05);
}

#video-hero-{{ sid }} .video-placeholder {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  background: radial-gradient(circle at center, #2a2a2a 0%, #111111 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

#video-hero-{{ sid }} .video-placeholder__badge {
  position: absolute;
  top: var(--space-md, 16px);
  right: var(--space-md, 16px);
  z-index: 3;
  display: inline-flex;
  align-items: center;
  gap: var(--space-xs, 8px);
  padding: 6px 14px;
  background: rgba(0, 0, 0, 0.65);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: var(--radius-sm, 4px);
  color: #ffffff;
  font-size: var(--font-size-xs, 12px);
  letter-spacing: 0.02em;
  pointer-events: none;
}

#video-hero-{{ sid }} .overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});
}

#video-hero-{{ sid }} .hero-content {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: min({{ section.settings.content_width | default: 80 }}cqw, var(--page-width));
  padding: var(--space-xl, 32px);
  color: var(--color-hero-text);
  text-align: center;
}

#video-hero-{{ sid }} .hero-title {
  font-family: var(--font-primary--family); 
  font-size: clamp(32px, 8cqw, 80px);
  font-weight: 300;
  letter-spacing: 0.08em;
  margin-bottom: var(--space-md, 16px);
  line-height: 1.1;
  text-transform: uppercase;
  color: currentColor;
}

#video-hero-{{ sid }} .hero-subtitle {
  font-size: clamp(16px, 2cqw, 24px);
  margin-bottom: var(--space-lg, 24px);
  opacity: 0.9;
  letter-spacing: 0.04em;
  color: currentColor;
}

#video-hero-{{ sid }} .hero-btn {
  display: inline-block;
  padding: var(--space-sm, 12px) var(--space-xl, 32px);
  background: var(--color-surface, #ffffff);
  color: var(--color-text-primary, #000000);
  text-transform: uppercase;
  letter-spacing: 0.15em;
  font-size: var(--font-size-sm, 14px);
  transition: transform var(--transition-fast, 0.2s ease), background var(--transition-fast, 0.2s ease), color var(--transition-fast, 0.2s ease);
  border-radius: var(--radius-md, 8px); 
  text-decoration: none;
}

#video-hero-{{ sid }} .hero-btn:hover {
  background: var(--color-text-primary, #000000);
  color: var(--color-surface, #ffffff);
  transform: translateY(-2px);
}

@container hero_container (max-width: 767px) {
  #video-hero-{{ sid }} .video-hero-container {
    height: {{ section.settings.height_mobile | default: 70 }}vh; 
  }
}
{% endstyle %}

{% schema %}
{
  "name": "Video Hero Pro",
  "tag": "section",
  "class": "section-video-hero",
  "settings": [
    {
      "type": "header",
      "content": "Video Source"
    },
    {
      "type": "video",
      "id": "hosted_video",
      "label": "Shopify-hosted video (Recommended)"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "YouTube / Vimeo link",
      "accept": ["youtube", "vimeo"]
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Desktop height",
      "default": 100
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Mobile height",
      "default": 70
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 40
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Content max width",
      "default": 80
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use automatic theme translation"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "info": "Leave blank to use automatic theme translation"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "info": "Leave blank to use automatic theme translation"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Video Hero Pro",
      "settings": {
        "text_color": "#ffffff",
        "height_desktop": 100,
        "height_mobile": 70,
        "overlay_opacity": 40,
        "content_width": 80,
        "heading": "",
        "subtitle": "",
        "button_label": ""
      }
    }
  ]
}
{% endschema %}