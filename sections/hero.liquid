<section class="shopify-section hero">
  <div class="hero__inner">

    <div class="hero__content">
      {% if section.settings.eyebrow != blank %}
        <span class="hero__eyebrow">
          {{ section.settings.eyebrow | t  }}
        </span>
      {% endif %}

      <h1 class="hero__title">
        {{ section.settings.heading | t }}
      </h1>

      <p class="hero__subtitle">
        {{ section.settings.subheading | t  }}
      </p>

      <a
        href="{{ section.settings.button_link }}"
        class="hero__button"
      >
        {{ section.settings.button_label | t  }}
      </a>
    </div>

    {% if section.settings.image != blank %}
      <div class="hero__media full-width">
        <img
          src="{{ section.settings.image | image_url: width: 1400 }}"
          alt="{{ section.settings.image.alt | escape }}"
          loading="lazy"
        >
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
  "type": "text",
  "id": "eyebrow",
  "label": "t:labels.hero_eyebrow",
  "default": "hero.eyebrow"
   },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.hero_heading",
      "default": "hero.heading"
    },
   {
  "type": "textarea",
  "id": "subheading",
  "label": "t:labels.hero_subheading",
  "default": "hero.subheading"
    },
    {
  "type": "text",
  "id": "button_label",
  "label": "t:labels.hero_button_label",
  "default": "hero.button_label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
