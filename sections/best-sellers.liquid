{% comment %}
  Best Sellers section
  - Fully accessible WAI-ARIA Tabs implementation
  - Keyboard navigation (Arrows, Home, End)
  - Fully self-contained (CSS + JS scoped per section instance)
  - Uses container queries for component-level responsiveness
{% endcomment %}

{%- assign sid = section.id -%}

<div id="section-{{ sid }}" class="best-sellers" data-component="best-sellers">
  {%- liquid
    assign default_label = 'sections.best_sellers.section_label' | t | default: 'Best Sellers'
    assign default_title = 'sections.best_sellers.title' | t | default: 'Trending Products'
    
    assign section_label = section.settings.section_label | default: default_label
    assign section_title = section.settings.title | default: default_title
  -%}

  <div class="page-width">
    <div class="best-sellers__container-wrapper">
      <div class="grid-container">
        
        <!-- NAVIGATION -->
        <div class="nav-col">
          <div class="header-group">
            {% if section.settings.section_label != blank %}
              <span class="label">
                {{ section_label }}
              </span>
            {% endif %}
            
            {% if section.settings.title != blank %}
              <h2 class="title" id="title-{{ sid }}">
                {{ section_title }}
              </h2>
            {% endif %}
          </div>

          <nav class="nav-wrapper">
            <ul 
              class="nav-list" 
              role="tablist" 
              aria-labelledby="title-{{ sid }}"
              data-tabs-nav
            >
              {% for block in section.blocks %}
                {% liquid
                  assign fallback_text = 'sections.best_sellers.collection_fallback' | t | default: 'Collection'
                  assign nav_title = block.settings.collection.title

                  if block.settings.collection_title != blank
                    assign nav_title = block.settings.collection_title
                  endif

                  assign nav_title = nav_title | default: fallback_text
                  assign is_first = forloop.first
                %}
                <li role="presentation" {{ block.shopify_attributes }}>
                  <button
                    id="tab-{{ sid }}-{{ forloop.index0 }}"
                    class="nav-btn {% if is_first %}active{% endif %}"
                    role="tab"
                    aria-selected="{% if is_first %}true{% else %}false{% endif %}"
                    aria-controls="panel-{{ sid }}-{{ forloop.index0 }}"
                    tabindex="{% if is_first %}0{% else %}-1{% endif %}"
                    data-index="{{ forloop.index0 }}"
                    data-action="tab-switch"
                    type="button"
                  >
                    <span class="nav-text">{{ nav_title }}</span>
                    <span class="nav-arrow" aria-hidden="true">→</span>
                  </button>
                </li>
              {% endfor %}
            </ul>
          </nav>
        </div>

        <!-- CONTENT -->
        <div class="content-col">
          {% for block in section.blocks %}
            {% liquid
              assign product = blank
              assign is_first = forloop.first

              if block.settings.product != blank
                assign product = block.settings.product
              elsif block.settings.collection != blank and block.settings.collection.products.size > 0
                assign product = block.settings.collection.products.first
              endif
            %}

            <div
              id="panel-{{ sid }}-{{ forloop.index0 }}"
              class="tab-panel {% if is_first %}active{% endif %}"
              role="tabpanel"
              aria-labelledby="tab-{{ sid }}-{{ forloop.index0 }}"
              tabindex="0"
              {% unless is_first %}hidden{% endunless %}
              data-index="{{ forloop.index0 }}"
              data-tab-panel
              {{ block.shopify_attributes }}
            >
              {% if product != blank %}
                {% render 'product-card', product_item: product, show_vendor: true %}
              {% else %}
                <div class="best-sellers__placeholder-card">
                  {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  <div class="placeholder-card__info">
                    <p class="placeholder-card__title">Product Title</p>
                    <p class="placeholder-card__price">$99.00</p>
                  </div>
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>

      </div>
    </div>
  </div>
</div>

{% style %}
  #section-{{ sid }} {
    width: 100%;
    --gap-dynamic: var(--space-xl);
    padding-block: var(--space-xl);
    max-width: var(--page-width);
    margin: 0 auto;
    font-family: var(--font-primary--family);
  }

  #section-{{ sid }} .best-sellers__container-wrapper {
    container-type: inline-size;
    container-name: best_sellers;
    display: block;
    width: 100%;
    position: relative;
  }

  #section-{{ sid }} .grid-container {
    display: flex;
    gap: var(--gap-dynamic);
    align-items: flex-start;
  }

  #section-{{ sid }} .nav-col {
    flex: 0 0 35%;
    width: 35%;
  }

  #section-{{ sid }} .header-group {
    margin-bottom: var(--space-md);
  }

  #section-{{ sid }} .label {
    font-family: var(--font-primary--family);
    font-weight: var(--font-weight-normal, 400);
    font-size: var(--font-size-base);
    line-height: var(--line-height-base, 1.5);
    color: var(--color-text-secondary);
    display: block;
    margin-bottom: var(--space-xs);
  }

  #section-{{ sid }} .title {
    font-family: var(--font-family-heading, var(--font-primary--family));
    font-weight: var(--font-weight-bold, 700);
    font-size: clamp(28px, 4cqw, 38px);
    line-height: var(--line-height-heading, 1.2);
    color: var(--color-foreground);
    word-break: normal;
  }

  #section-{{ sid }} .nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  #section-{{ sid }} .nav-btn {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: none;
    border: none;
    border-bottom: 1px solid transparent;
    padding: var(--space-sm) 0;
    cursor: pointer;
    color: var(--color-text-muted);
    transition: color var(--transition-fast), border-color var(--transition-fast);
    text-align: left;
    font-family: var(--font-primary--family);
    font-weight: var(--font-weight-medium, 500);
    font-size: clamp(18px, 3cqw, 28px);
    line-height: 1.2;
  }

  #section-{{ sid }} .nav-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  #section-{{ sid }} .nav-arrow {
    opacity: 0;
    transition: transform var(--transition-fast), opacity var(--transition-fast);
    transform: translateX(-10px);
  }

  #section-{{ sid }} .nav-btn[aria-selected="true"] {
    color: var(--color-foreground);
    font-weight: var(--font-weight-bold, 700);
    border-bottom-color: var(--color-foreground);
  }

  #section-{{ sid }} .nav-btn[aria-selected="true"] .nav-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  #section-{{ sid }} .content-col {
    flex: 1;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr;
    align-items: start;
  }

  #section-{{ sid }} .tab-panel[hidden] {
    display: none !important;
  }

  #section-{{ sid }} .tab-panel:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  #section-{{ sid }} .best-sellers__placeholder-card {
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    background: var(--color-surface-subtle);
    text-align: center;
  }

  @container best_sellers (max-width: 767px) {
    #section-{{ sid }} {
      padding-block: var(--space-lg);
      --gap-dynamic: var(--space-md);
    }

    #section-{{ sid }} .grid-container {
      flex-direction: column;
    }

    #section-{{ sid }} .nav-col {
      width: 100%;
      flex: none;
    }

    #section-{{ sid }} .nav-btn {
      font-size: var(--heading-sm);
      padding: var(--space-xs) 0;
    }

    #section-{{ sid }} .content-col {
      width: 100%;
    }
  }
{% endstyle %}

<script>
  (function() {
    function initBestSellers() {
      const root = document.querySelector('#section-{{ sid }}[data-component="best-sellers"]');
      if (!root) return;

      const tabs = Array.from(root.querySelectorAll('[role="tab"]'));
      const panels = Array.from(root.querySelectorAll('[role="tabpanel"]'));

      if (!tabs.length || !panels.length) return;

      function switchTab(newTab) {
        const targetIndex = newTab.dataset.index;

        tabs.forEach(tab => {
          const isActive = tab === newTab;
          tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
          tab.setAttribute('tabindex', isActive ? '0' : '-1');
          tab.classList.toggle('active', isActive);
        });

        panels.forEach(panel => {
          const isTarget = panel.dataset.index === targetIndex;
          if (isTarget) {
            panel.removeAttribute('hidden');
            panel.classList.add('active');

            // Подгружаем lazy-картинки и триггерим перерасчет размеров
            panel.querySelectorAll('img[loading="lazy"]').forEach(img => {
              img.removeAttribute('loading');
            });
            window.dispatchEvent(new Event('resize'));
          } else {
            panel.setAttribute('hidden', '');
            panel.classList.remove('active');
          }
        });

        newTab.focus();
      }

      // Mouse click event
      tabs.forEach(tab => {
        tab.addEventListener('click', () => switchTab(tab));
      });

      // Keyboard Navigation
      root.querySelector('[role="tablist"]')?.addEventListener('keydown', (e) => {
        const currentTab = document.activeElement;
        if (!tabs.includes(currentTab)) return;

        let targetTab = null;
        const currentIndex = tabs.indexOf(currentTab);

        switch (e.key) {
          case 'ArrowDown':
          case 'ArrowRight':
            e.preventDefault();
            targetTab = tabs[(currentIndex + 1) % tabs.length];
            break;

          case 'ArrowUp':
          case 'ArrowLeft':
            e.preventDefault();
            targetTab = tabs[(currentIndex - 1 + tabs.length) % tabs.length];
            break;

          case 'Home':
            e.preventDefault();
            targetTab = tabs[0];
            break;

          case 'End':
            e.preventDefault();
            targetTab = tabs[tabs.length - 1];
            break;
        }

        if (targetTab) {
          switchTab(targetTab);
        }
      });
    }

    initBestSellers();

    if (window.Shopify && Shopify.designMode) {
      document.addEventListener('shopify:section:load', (e) => {
        if (e.detail.sectionId === '{{ sid }}') {
          initBestSellers();
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Best Sellers",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "section_label",
      "label": "Top Label",
      "default": "Best Sellers"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Main Title",
      "default": "Trending Products"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection Tab",
      "limit": 5,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "collection_title",
          "label": "Custom Tab Title",
          "info": "Overrides collection name if set."
        },
        {
          "type": "product",
          "id": "product",
          "label": "Override Product",
          "info": "Force a specific product for this tab instead of the first collection item."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Best Sellers Tabs",
      "settings": {
        "section_label": "Curated Selection",
        "title": "Best Sellers"
      },
      "blocks": [
        {
          "type": "collection",
          "settings": {
            "collection_title": "New Arrivals"
          }
        },
        {
          "type": "collection",
          "settings": {
            "collection_title": "Most Popular"
          }
        },
        {
          "type": "collection",
          "settings": {
            "collection_title": "Limited Edition"
          }
        }
      ]
    }
  ]
}
{% endschema %}