{% liquid
  assign sid = section.id | replace: '-', '_'
  assign title_align = section.settings.title_alignment | default: 'center'
  assign subtitle_align = section.settings.subtitle_alignment | default: 'center'
  assign desc_align = section.settings.description_alignment | default: 'center'
  assign list_align = section.settings.list_alignment | default: 'left'

  assign title_default = 'sections.about_brand.title' | t | default: 'Peak Framework'
  assign subtitle_default = 'sections.about_brand.subtitle' | t | default: 'Flexible, modern, and fully modular Shopify theme.'

  assign aboutbrand_title = section.settings.title | default: title_default
  assign aboutbrand_subtitle = section.settings.subtitle | default: subtitle_default
%}

<section id="about-{{ sid }}" class="section section--about about">
  <div class="about__inner">
    <!-- HERO -->
    {% if section.settings.title != blank or section.settings.subtitle != blank %}
      <header class="about__hero">
        {% if aboutbrand_title != blank %}
          <h1 class="about__title">
            {{ aboutbrand_title | escape }}
          </h1>
        {% endif %}

        {% if aboutbrand_subtitle != blank %}
          <p class="about__subtitle">
            {{ aboutbrand_subtitle | escape }}
          </p>
        {% endif %}
      </header>
    {% endif %}

    <!-- DESCRIPTION -->
    {% if section.settings.description != blank %}
      <div class="about__description rte">
        {{ section.settings.description }}
      </div>
    {% endif %}

    <!-- IMAGES -->
    {% if section.settings.show_images %}
      <div class="about__media">
        {% for i in (1..3) %}
          {% liquid
            assign image_key = 'image_' | append: i
            assign image = section.settings[image_key]
            
            assign default_alt = image.alt | default: aboutbrand_title
            assign about_alt = default_alt | escape
          %}

          <figure class="about__media-item">
            {% if image %}
              {% render 'image',
                image: image,
                width: 900,
                loading: 'lazy',
                sizes: '(min-width: 768px) 33vw, 100vw',
                wrapper_class: 'about__media-image-wrapper',
                alt: about_alt
              %}
            {% else %}
              {% assign placeholder_num = i %}
              {% if placeholder_num > 2 %}
                {% assign placeholder_num = 1 %}
              {% endif %}
              {{ 'lifestyle-' | append: placeholder_num | placeholder_svg_tag: 'about__placeholder' }}
            {% endif %}
          </figure>
        {% endfor %}
      </div>
    {% endif %}

    <!-- FEATURES BLOCK GRID -->
    {% if section.blocks.size > 0 %}
      <div class="about__features">
        {% for block in section.blocks %}
          {% if block.type == 'feature_card' %}
            <article class="about__feature" {{ block.shopify_attributes }}>
              {% if block.settings.title != blank %}
                <h3 class="about__feature-title">
                  {{ block.settings.title | escape }}
                </h3>
              {% endif %}
              {% if block.settings.text != blank %}
                <p class="about__feature-text">
                  {{ block.settings.text | escape }}
                </p>
              {% endif %}
            </article>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    <!-- LIST / BOTTOM SECTION -->
    {% if section.settings.list_title != blank or section.settings.list_content != blank %}
      <section class="about__list">
        {% if section.settings.list_title != blank %}
          <h2 class="about__list-title">
            {{ section.settings.list_title | escape }}
          </h2>
        {% endif %}

        {% if section.settings.list_content != blank %}
          <div class="about__list-content rte">
            {{ section.settings.list_content }}
          </div>
        {% endif %}
      </section>
    {% endif %}
  </div>
</section>

{% style %}
#about-{{ sid }} {
  --about-content-width: {{ section.settings.content_width | default: 1200 }}px;
  --about-title-align: {{ title_align }};
  --about-subtitle-align: {{ subtitle_align }};
  --about-desc-align: {{ desc_align }};
  --about-list-align: {{ list_align }};

  padding: var(--space-2xl) var(--page-margin);
}

#about-{{ sid }} .about__inner {
  max-width: var(--about-content-width);
  margin: 0 auto;
}

/* HERO ALIGNMENT */
#about-{{ sid }} .about__hero {
  margin-bottom: var(--space-xl, 32px);
  display: flex;
  flex-direction: column;
  width: 100%;
}

#about-{{ sid }} .about__title {
  text-align: var(--about-title-align);
  font-size: var(--hero-title, clamp(28px, 4vw, 42px));
  margin-top: 0;
  margin-bottom: var(--space-sm, 16px);
  color: var(--color-text-primary, currentColor);
  width: 100%;
}

#about-{{ sid }} .about__subtitle {
  text-align: var(--about-subtitle-align);
  font-size: var(--subtitle, 18px);
  color: var(--color-text-secondary, #666666);
  margin-top: 0;
  width: 100%;
}

/* DESCRIPTION ALIGNMENT */
#about-{{ sid }} .about__description {
  margin-bottom: var(--space-xl);
  text-align: var(--about-desc-align);
}

/* MEDIA GRID */
#about-{{ sid }} .about__media {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: var(--space-md);
  margin-bottom: var(--space-xl);
}

#about-{{ sid }} .about__media-item {
  margin: 0;
  overflow: hidden;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  background: var(--color-surface-subtle);
  aspect-ratio: 4 / 3;
}

#about-{{ sid }} .about__media-item img,
#about-{{ sid }} .about__placeholder {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform var(--transition-base);
}

#about-{{ sid }} .about__media-item:hover img {
  transform: scale(1.03);
}

/* FEATURES GRID */
#about-{{ sid }} .about__features {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: var(--space-md);
  margin-bottom: var(--space-xl);
}

#about-{{ sid }} .about__feature {
  padding: var(--space-lg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-surface);
  box-shadow: var(--shadow-sm);
  transition: transform var(--transition-base), box-shadow var(--transition-base);
  will-change: transform;
}

#about-{{ sid }} .about__feature-title {
  font-family: var(--font-family-heading);
  font-size: var(--heading-sm);
  margin: 0 0 var(--space-xs) 0;
  color: var(--color-text-primary);
}

#about-{{ sid }} .about__feature-text {
  font-family: var(--font-family-body);
  color: var(--color-text-secondary);
  font-size: var(--text-small);
  line-height: var(--line-height-base);
  margin: 0;
}

#about-{{ sid }} .about__feature:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

/* LIST ALIGNMENT & BULLETS FIX */
#about-{{ sid }} .about__list {
  padding-top: var(--space-lg);
  border-top: 1px solid var(--color-border);
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  text-align: var(--about-list-align);
}

#about-{{ sid }} .about__list-title {
  font-size: var(--heading-md, 24px);
  margin-top: 0;
  margin-bottom: var(--space-xs, 8px);
  color: var(--color-text-primary, #000000);
  text-align: var(--about-list-align);
}

#about-{{ sid }} .about__list-content {
  text-align: var(--about-list-align);
}

#about-{{ sid }} .about__list-content ul,
#about-{{ sid }} .about__list-content ol {
  list-style-position: inside;
  padding-left: 0;
  margin: 0;
  text-align: var(--about-list-align);
}

#about-{{ sid }} .about__list-content li {
  margin-bottom: var(--space-xs, 4px);
}
{% endstyle %}

