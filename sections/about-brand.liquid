{% liquid
  assign sid = section.id | replace: '-', '_'

  assign title_default = 'sections.about_brand.title' | t | default: 'Peak Framework'
  assign subtitle_default = 'sections.about_brand.subtitle' | t | default: 'Flexible, modern, and fully modular Shopify theme.'

  assign aboutbrand_title = section.settings.title | default: title_default
  assign aboutbrand_subtitle = section.settings.subtitle | default: subtitle_default
%}

<section id="about-{{ sid }}" class="section section--about about">
  <div class="about__inner">
    <!-- HERO -->
    {% if section.settings.title != blank or section.settings.subtitle != blank %}
      <header class="about__hero">
        {% if aboutbrand_title != blank %}
          {% render 'builder-heading', 
            block: section, 
            title: aboutbrand_title, 
            tag: 'h1', 
            alignment: 'center' 
          %}
        {% endif %}

        {% if aboutbrand_subtitle != blank %}
          <p class="about__subtitle">
            {{ aboutbrand_subtitle | escape }}
          </p>
        {% endif %}
      </header>
    {% endif %}

    <!-- DESCRIPTION -->
    {% if section.settings.description != blank %}
      <div class="about__description">
        {% render 'builder-text', block: section, content: section.settings.description %}
      </div>
    {% endif %}

    <!-- IMAGES -->
    {% if section.settings.show_images %}
      <div class="about__media">
        {% for i in (1..3) %}
          {% liquid
            assign image_key = 'image_' | append: i
            assign image = section.settings[image_key]
            
            assign default_alt = image.alt | default: aboutbrand_title
            assign about_alt = default_alt | escape
          %}

          <figure class="about__media-item">
            {% if image %}
              {% render 'image',
                image: image,
                width: 900,
                loading: 'lazy',
                sizes: '(min-width: 768px) 33vw, 100vw',
                wrapper_class: 'about__media-image-wrapper',
                alt: about_alt
              %}
            {% else %}
              {{ 'lifestyle-' | append: i | placeholder_svg_tag: 'about__placeholder' }}
            {% endif %}
          </figure>
        {% endfor %}
      </div>
    {% endif %}

    <!-- FEATURES BLOCK GRID -->
    {% if section.blocks.size > 0 %}
      <div class="about__features">
        {% for block in section.blocks %}
          {% if block.type == 'feature_card' %}
            <article class="about__feature" {{ block.shopify_attributes }}>
              {% if block.settings.title != blank %}
                <h3 class="about__feature-title">
                  {{ block.settings.title | escape }}
                </h3>
              {% endif %}
              {% if block.settings.text != blank %}
                <p class="about__feature-text">
                  {{ block.settings.text | escape }}
                </p>
              {% endif %}
            </article>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    <!-- LIST / BOTTOM SECTION -->
    {% if section.settings.list_title != blank or section.settings.list_content != blank %}
      <section class="about__list">
        {% if section.settings.list_title != blank %}
          {% render 'builder-heading', 
            block: section, 
            title: section.settings.list_title, 
            tag: 'h2', 
            alignment: 'left' 
          %}
        {% endif %}

        {% if section.settings.list_content != blank %}
          <div class="about__list-content">
            {% render 'builder-text', block: section, content: section.settings.list_content %}
          </div>
        {% endif %}
      </section>
    {% endif %}
  </div>
</section>

{% style %}
#about-{{ sid }} {
  --about-content-width: {{ section.settings.content_width | default: 1200 }}px;
  padding: var(--space-2xl) var(--page-margin);
}

#about-{{ sid }} .about__inner {
  max-width: var(--about-content-width);
  margin: 0 auto;
}

#about-{{ sid }} .about__hero {
  text-align: center;
  margin-bottom: var(--space-xl);
  display: flex;
  flex-direction: column;
  align-items: center;
}

#about-{{ sid }} .about__subtitle {
  font-family: var(--font-family-body);
  font-size: var(--subtitle);
  color: var(--color-text-secondary);
  margin-top: var(--space-xs);
}

#about-{{ sid }} .about__description {
  margin-bottom: var(--space-xl);
  text-align: center;
}

/* MEDIA GRID */
#about-{{ sid }} .about__media {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: var(--space-md);
  margin-bottom: var(--space-xl);
}

#about-{{ sid }} .about__media-item {
  margin: 0;
  overflow: hidden;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  background: var(--color-surface-subtle);
  aspect-ratio: 4 / 3;
}

#about-{{ sid }} .about__media-item img,
#about-{{ sid }} .about__placeholder {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform var(--transition-base);
}

#about-{{ sid }} .about__media-item:hover img {
  transform: scale(1.03);
}

/* FEATURES GRID */
#about-{{ sid }} .about__features {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: var(--space-md);
  margin-bottom: var(--space-xl);
}

#about-{{ sid }} .about__feature {
  padding: var(--space-lg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-surface);
  box-shadow: var(--shadow-sm);
  transition: transform var(--transition-base), box-shadow var(--transition-base);
  will-change: transform;
}

#about-{{ sid }} .about__feature-title {
  font-family: var(--font-family-heading);
  font-size: var(--heading-sm);
  margin: 0 0 var(--space-xs) 0;
  color: var(--color-text-primary);
}

#about-{{ sid }} .about__feature-text {
  font-family: var(--font-family-body);
  color: var(--color-text-secondary);
  font-size: var(--text-small);
  line-height: var(--line-height-base);
  margin: 0;
}

#about-{{ sid }} .about__feature:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

/* LIST CONTENT */
#about-{{ sid }} .about__list {
  padding-top: var(--space-lg);
  border-top: 1px solid var(--color-border);
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}
{% endstyle %}

{% schema %}
{
  "name": "About Page",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 600,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "header",
      "content": "Hero Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Main Title",
      "default": "Peak Framework"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Flexible, modern, and fully modular Shopify theme."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description text",
      "default": "<p><b>Peak</b> is an ecosystem of isolated sections. Each block features independent logic and styles, fully manageable via the customizer. Control colors, fonts, and spacing with zero coding. Your freedom is our priority.</p>"
    },
    {
      "type": "header",
      "content": "Media Grid"
    },
    {
      "type": "checkbox",
      "id": "show_images",
      "label": "Enable Media Section",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image 3"
    },
    {
      "type": "header",
      "content": "List Section"
    },
    {
      "type": "text",
      "id": "list_title",
      "label": "List Title",
      "default": "What This Theme Demonstrates"
    },
    {
      "type": "richtext",
      "id": "list_content",
      "label": "List Content",
      "default": "<ul><li>Reusable layout system</li><li>Design tokens integration</li><li>Isolated Architecture</li><li>Multilingual Core</li></ul>"
    }
  ],
  "blocks": [
    {
      "type": "feature_card",
      "name": "Feature Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "Feature"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Card Text",
          "default": "Reusable sections and scalable CSS variables."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Page (Full Brand Story)",
      "settings": {
        "content_width": 1200,
        "title": "Peak Framework",
        "subtitle": "Flexible, modern, and fully modular Shopify theme.",
        "show_images": true,
        "list_title": "What This Theme Demonstrates"
      },
      "blocks": [
        {
          "type": "feature_card",
          "settings": {
            "title": "Atomic Architecture",
            "text": "Each section is fully isolated. Styles and logic live inside the module — copy and reuse in any project."
          }
        },
        {
          "type": "feature_card",
          "settings": {
            "title": "Full Control",
            "text": "Global styles are centralized, but everything — spacing, typography, colors — is configurable via the customizer."
          }
        },
        {
          "type": "feature_card",
          "settings": {
            "title": "Multilingual Ready",
            "text": "All interface and content strings are prepared for easy localization from day one."
          }
        },
        {
          "type": "feature_card",
          "settings": {
            "title": "Your Rules",
            "text": "A flexible foundation you can adapt 100% to your needs. No restrictions. No unnecessary code."
          }
        }
      ]
    },
    {
      "name": "About Page (Minimal Features Grid)",
      "settings": {
        "content_width": 960,
        "title": "Core Features",
        "subtitle": "Everything you need to build high-converting storefronts.",
        "description": "",
        "show_images": false,
        "list_title": ""
      },
      "blocks": [
        {
          "type": "feature_card",
          "settings": {
            "title": "Performance First",
            "text": "Zero heavy dependencies. Pure CSS custom variables and native Liquid filters."
          }
        },
        {
          "type": "feature_card",
          "settings": {
            "title": "Design Tokens",
            "text": "Consistent typography scale, border radius, and dynamic spacing rules."
          }
        },
        {
          "type": "feature_card",
          "settings": {
            "title": "Shopify 2.0 Standard",
            "text": "Full support for JSON templates, app blocks, and section presets."
          }
        }
      ]
    }
  ]
}
{% endschema %}