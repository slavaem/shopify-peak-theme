{
  "sections": {
    "hero_banner": {
      "type": "custom-section",
      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "heading": "SPECIAL PROMO OFFER",
            "heading_size": "h1"
          }
        },
        "text_1": {
          "type": "richtext",
          "settings": {
            "text": "<p>Discover our exclusive products engineered for maximum performance and modern lifestyle.</p>"
          }
        },
        "button_1": {
          "type": "button",
          "settings": {
            "button_label": "SHOP NOW",
            "button_link": "/collections/all",
            "button_style_secondary": false
          }
        }
      },
      "block_order": ["heading_1", "text_1", "button_1"],
      "settings": {
        "min_height": 520,
        "overlay_opacity": 25,
        "color_mode": "theme",
        "desktop_content_alignment": "center",
        "desktop_content_position": "center",
        "text_alignment": "center",
        "content_max_width": 680,
        "card_bg_color": "#ffffff",
        "card_bg_opacity": 90,
        "enable_blur": true,
        "card_padding": 40,
        "card_corner_radius": 12,
        "padding_top": 0,
        "padding_bottom": 40
      }
    },
    "page_content": {
      "type": "page-builder"
    },
    "about_content": {
      "type": "about-brand"
    }
  },
  "order": ["about_content", "hero_banner", "page_content"]
}
