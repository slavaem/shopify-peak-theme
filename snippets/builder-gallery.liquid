{% doc %}
  Builder Gallery

  Displays up to three images in a grid layout.

  Usage:
    {% render 'builder-gallery', block: block %}

  Dependencies:
    - snippets/image.liquid

  Example Block Schema (Скопируй этот JSON в schema нужной секции в массив "blocks"):
  {
    "type": "gallery",
    "name": "Image Gallery",
    "settings": [
      {
        "type": "select",
        "id": "layout",
        "label": "Layout columns",
        "options": [
          { "value": "1", "label": "1 Column" },
          { "value": "2", "label": "2 Columns" },
          { "value": "3", "label": "3 Columns" }
        ],
        "default": "3"
      },
      { "type": "image_picker", "id": "image_1", "label": "Image 1" },
      { "type": "image_picker", "id": "image_2", "label": "Image 2" },
      { "type": "image_picker", "id": "image_3", "label": "Image 3" }
    ]
  }
{% enddoc %}

{% assign has_images = false %}

{% capture gallery %}
  {% for i in (1..3) %}
    {% assign img_key = 'image_' | append: i %}
    {% assign image = block.settings[img_key] %}

    {% if image %}
      {% assign has_images = true %}

      <figure class="builder__gallery-item">
        {% render 'image',
          image: image,
          width: 900,
          loading: 'lazy',
          class: 'builder__gallery-image'
        %}
      </figure>
    {% endif %}
  {% endfor %}
{% endcapture %}

{% if has_images %}
  <div class="builder__gallery builder__gallery--{{ block.settings.layout | default: '3' }}">
    {{ gallery }}
  </div>
{% endif %}

{% style %}
.builder__gallery {
  display: grid;
  gap: var(--space-md);
  width: 100%;
}

.builder__gallery--1 {
  grid-template-columns: 1fr;
}

.builder__gallery--2 {
  grid-template-columns: repeat(2, 1fr);
}

.builder__gallery--3 {
  grid-template-columns: repeat(3, 1fr);
}

.builder__gallery-item {
  margin: 0;
  display: flex;
  aspect-ratio: 1;
  overflow: hidden;
  border-radius: var(--radius-md);
  background-color: var(--color-surface-subtle);
}

.builder__gallery-image {
  width: 100%;
  height: 100%;
}

.builder__gallery-image img,
.builder__gallery-image .image__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform var(--transition-base, 0.3s ease);
}

.builder__gallery-item:hover .builder__gallery-image img,
.builder__gallery-item:hover .builder__gallery-image .image__img {
  transform: scale(1.04);
}

@media (max-width: 767px) {
  .builder__gallery--2,
  .builder__gallery--3 {
    grid-template-columns: 1fr;
  }
}
{% endstyle %}