<div class="mobile-menu" data-component="mobile-menu" hidden>
  <div class="mobile-menu__overlay" data-action="mobile-menu-close"></div>

  <div 
    class="mobile-menu__panel" 
    role="dialog" 
    aria-modal="true" 
    aria-label="{{ 'sections.header.menu' | t | default: 'Navigation' }}"
  >
    <div class="mobile-menu__header">
      <button 
        type="button" 
        class="mobile-menu__close" 
        data-action="mobile-menu-close"
        aria-label="{{ 'accessibility.close' | t | default: 'Close' }}"
      >
        &times;
      </button>
    </div>

    <nav 
      class="mobile-menu__nav" 
      aria-label="{{ 'sections.header.menu' | t | default: 'Navigation' }}"
    >
      {% if menu != blank and menu.links.size > 0 %}
        <ul class="mobile-menu__list" role="list">
          {% for link in menu.links %}
            <li class="mobile-menu__item">
              <a 
                href="{{ link.url }}" 
                class="mobile-menu__link {% if link.active %}is-active{% endif %}"
              >
                {{ link.title | escape }}
              </a>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </nav>
  </div>
</div>