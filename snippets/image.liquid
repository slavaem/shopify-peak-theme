{%- doc -%}
  Renders a responsive image.

  @param {image} image - Shopify image object
  @param {string} [url] - Optional link URL
  @param {string} [wrapper_class] - Additional wrapper classes
  @param {number} [width] - Maximum image width
  @param {number} [height] - Maximum image height
  @param {string} [crop] - Crop position
  @param {string} [loading] - lazy | eager
  @param {string} [sizes] - Responsive sizes attribute
  @param {string} [widths] - Srcset widths
  @param {string} [alt] - Custom alt text
{%- enddoc -%}

{{ 'component-image.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign wrapper = 'div'
  if url
    assign wrapper = 'a'
  endif

  assign image_width = width | default: image.width
  assign image_loading = loading | default: 'lazy'

  assign preload_image = false
  if image_loading == 'eager'
    assign preload_image = true
  endif

  assign image_widths = widths | default: '320,480,640,768,960,1200,1440,1920'
  assign image_alt = alt | default: image.alt | default: page_title | escape
-%}

{%- if image -%}
  <{{ wrapper }}
    class="image{% if wrapper_class %} {{ wrapper_class }}{% endif %}"
    {% if url %}
      href="{{ url }}"
    {% endif %}
  >
    {{
      image
      | image_url: width: image_width, height: height, crop: crop
      | image_tag:
        class: 'image__img',
        loading: image_loading,
        preload: preload_image,
        widths: image_widths,
        sizes: sizes,
        alt: image_alt
    }}
  </{{ wrapper }}>
{%- endif -%}