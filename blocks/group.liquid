{% doc %}
  Layout Container
  A flexible wrapper block for composing complex layouts inside the Theme Editor.

  Features:
  - Vertical / Horizontal layout
  - Content width presets
  - Configurable gap
  - Horizontal & vertical alignment
  - Nested blocks support
{% enddoc %}

{% liquid
  assign classes = 'peak-layout'
  assign classes = classes | append: ' peak-layout--' | append: block.settings.layout_direction
  assign classes = classes | append: ' peak-layout--width-' | append: block.settings.content_width

  if block.settings.layout_direction == 'vertical'
    assign horizontal_align = block.settings.align_items | default: 'flex-start'
  else
    assign horizontal_align = block.settings.justify_content | default: 'flex-start'
  endif
%}

<div
  class="{{ classes }}"
  style="
    --layout-gap:{% if block.settings.gap == 'none' %}0{% else %}var(--space-{{ block.settings.gap }}){% endif %};
    --layout-horizontal-alignment:{{ horizontal_align }};
    --layout-vertical-alignment:{{ block.settings.vertical_alignment | default: 'center' }};
  "
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% style %}
.peak-layout{
    display:flex;
    width:100%;
    margin-inline:auto;
    box-sizing:border-box;
    gap:var(--layout-gap);
}

/* =========================
   Direction
========================= */

.peak-layout--vertical{
  flex-direction:column;
  align-items:var(--layout-horizontal-alignment);
}

.peak-layout--horizontal{
  flex-direction:row;
  justify-content:var(--layout-horizontal-alignment);
  align-items:var(--layout-vertical-alignment);
}

/* =========================
   Width
========================= */

.peak-layout--width-narrow{
  max-width: var(--content-width-narrow);
}

.peak-layout--width-normal{
  max-width: var(--content-width-normal);
}

.peak-layout--width-wide{
  max-width: var(--content-width-wide);
}

.peak-layout--width-full{
  max-width: var(--content-width-full);
}

/* =========================
   Children
========================= */

.peak-layout > *{
  max-width:100%;
  box-sizing:border-box;
}

/* =========================
   Mobile
========================= */

@media (max-width:767px){
  .peak-layout--horizontal{
    flex-direction:column;
    justify-content:flex-start;
    align-items: var(--layout-horizontal-alignment);
  }
}
{% endstyle %}

{% schema %}
{
  "name": "Layout Container",
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_direction",
      "label": "Direction",
      "default": "vertical",
      "options": [
        { "value": "vertical", "label": "Vertical" },
        { "value": "horizontal", "label": "Horizontal" }
      ]
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "default": "normal",
      "options": [
        { "value": "narrow", "label": "Narrow" },
        { "value": "normal", "label": "Normal" },
        { "value": "wide", "label": "Wide" },
        { "value": "full", "label": "Full width" }
      ]
    },
    {
  "type": "select",
  "id": "gap",
  "label": "Gap between blocks",
  "default": "md",
  "options": [
    { "value": "none", "label": "None (0px)" },
    { "value": "2xs", "label": "Extra Extra Small" },
    { "value": "xs", "label": "Extra Small" },
    { "value": "sm", "label": "Small" },
    { "value": "md", "label": "Medium" },
    { "value": "lg", "label": "Large" },
    { "value": "xl", "label": "Extra Large" },
    { "value": "2xl", "label": "2X Large" }
      ]
    },
    {
      "type": "header",
      "content": "Alignment"
    },
    {
      "visible_if": "{{ block.settings.layout_direction == 'vertical' }}",
      "type": "select",
      "id": "align_items",
      "label": "Horizontal alignment",
      "default": "flex-start",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ]
    },
    {
      "visible_if": "{{ block.settings.layout_direction == 'horizontal' }}",
      "type": "select",
      "id": "justify_content",
      "label": "Horizontal alignment",
      "default": "flex-start",
      "options": [
        { "value": "flex-start", "label": "Start" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "End" },
        { "value": "space-between", "label": "Space Between" }
      ]
    },
    {
      "visible_if": "{{ block.settings.layout_direction == 'horizontal' }}",
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical alignment",
      "default": "center",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Bottom" },
        { "value": "stretch", "label": "Stretch" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Flex Column",
      "settings": {
        "layout_direction": "vertical",
        "content_width": "normal",
        "gap": "md"
      }
    },
    {
      "name": "Flex Row",
      "settings": {
        "layout_direction": "horizontal",
        "content_width": "full",
        "gap": "md"
      }
    }
  ]
}
{% endschema %}